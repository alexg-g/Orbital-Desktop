# Orbital Backend Test Environment Configuration
# This file is used exclusively for running integration tests
# It overrides .env.local and .env when NODE_ENV=test

# Server Configuration
NODE_ENV=test
PORT=3000

# Test Database Configuration (Isolated from development/production)
# Uses separate Docker container on port 5433
DATABASE_URL=postgresql://orbital_test_user:orbital_test_password@localhost:5433/orbital_test

# JWT Authentication
JWT_SECRET=orbital-test-secret-key-do-not-use-in-production
JWT_EXPIRATION=30d

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Media Storage (use temp directory for tests)
MEDIA_STORAGE_PATH=./uploads-test
MAX_FILE_SIZE_MB=500

# Logging (less verbose in tests)
LOG_LEVEL=error

# Rate Limiting (disabled for tests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
